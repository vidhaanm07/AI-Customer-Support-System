    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI customer support classifier.\n\nAnalyze this customer ticket.\n\nReturn ONLY valid JSON.\n\nClassify:\n\nCategory:\nTechnical\nBilling\nAccount\nSecurity\nFeature Request\nOther\n\n\nPriority:\nLow\nMedium\nHigh\nCritical\n\n\nSentiment:\nPositive\nNeutral\nNegative\n\n\nDepartment:\nTechnical\nBilling\nAccount\nSecurity\n\n\nHuman Required:\ntrue or false\n\n\nSummary:\nShort explanation of issue.\n\n\nCustomer Name:\n{{$json.customer_name}}\n\nSubject:\n{{$json.subject}}\n\nMessage:\n{{$json.message}}",
        "options": {}
      },
